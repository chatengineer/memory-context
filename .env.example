# Environment Configuration Example for Memory Context Plugin
# Copy this file to .env for local testing or custom deployments.
# IMPORTANT: Never commit actual keys, tokens, or credentials to git.

# Runtime environment (development | test | production)
NODE_ENV=development

# Storage directory for SQLite database and plugin cache files
# Default: ./data (inside plugin directory) or ~/.openclaw/data/memory-context
MEMORY_CONTEXT_DATA_DIR=./data

# Logging verbosity (debug | info | warn | error)
MEMORY_CONTEXT_LOG_LEVEL=info

# Optional: Default target token utilization ratio (0.5 - 1.0)
MEMORY_CONTEXT_TARGET_UTILIZATION=0.95

# Optional: Maximum context tokens threshold for JIT assembly
MEMORY_CONTEXT_MAX_TOKENS=128000
