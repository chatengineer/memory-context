{
  "id": "memory-context",
  "name": "Memory Context - Zero-Shift Context Engine",
  "version": "1.0.0",
  "description": "Zero-shift memory/context engine for OpenClaw with JIT assembly, typed anchors, predictive recall, SQLite-backed persistence, and runtime search/recall tools.",
  "kind": "memory",
  "main": "./src/index.ts",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "maxContextTokens": {
        "type": "integer",
        "default": 128000,
        "minimum": 1024,
        "description": "Maximum context token budget available to the engine"
      },
      "targetUtilization": {
        "type": "number",
        "default": 0.95,
        "minimum": 0,
        "maximum": 1,
        "description": "Target fraction of the context window to use"
      },
      "zeroShiftEnabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable zero-shift rebuild mode"
      },
      "quantumAnchorsEnabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable typed quantum anchors and shift immunity"
      },
      "persistenceEnabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable SQLite-backed persistence for memory state"
      },
      "predictiveAssemblyEnabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable predictive topic transition learning and pre-assembly"
      },
      "statePath": {
        "type": "string",
        "description": "Path to the SQLite-backed plugin state database"
      },
      "tieredStorageConfig": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "l0MaxTokens": { "type": "integer", "minimum": 1 },
          "l1MaxTokens": { "type": "integer", "minimum": 1 },
          "l2MaxTokens": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "tools": [
    "memory_context_build",
    "memory_context_stats",
    "memory_context_search",
    "memory_context_anchor",
    "memory_context_jit_build",
    "memory_context_jit_clear",
    "memory_context_shift_check",
    "memory_context_diff",
    "memory_context_history",
    "memory_context_recall",
    "memory_context_profile",
    "memory_context_validate",
    "memory_context_snapshot",
    "memory_context_restore",
    "memory_context_optimize"
  ],
  "gatewayMethods": [
    "memory_context.status",
    "memory_context.build",
    "memory_context.jit_build",
    "memory_context.jit_stats",
    "memory_context.jit_clear",
    "memory_context.shift_detect",
    "memory_context.validate",
    "memory_context.history",
    "memory_context.search",
    "memory_context.anchor"
  ]
}
