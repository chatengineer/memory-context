{
  "name": "memory-context",
  "version": "1.5.5",
  "description": "Advanced context preservation system for OpenClaw with JIT hierarchical assembly, tiered storage, and shift-immunity safeguards",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "index.ts",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc -watch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration",
    "benchmark": "node --experimental-strip-types benchmarks/run-benchmarks.ts",
    "benchmark:locomo": "node benchmarks/run-locomo-regression.js",
    "verify:metadata": "node scripts/verify-metadata.js",
    "ci": "npm run verify:metadata && npm run build && npm run test:coverage"
  },
  "keywords": [
    "openclaw",
    "memory",
    "context",
    "jit",
    "hierarchical",
    "bm25",
    "plugin"
  ],
  "author": "Chat Engineer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chatengineer/memory-context.git"
  },
  "bugs": {
    "url": "https://github.com/chatengineer/memory-context/issues"
  },
  "homepage": "https://github.com/chatengineer/memory-context#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "gpt-tokenizer": "^3.4.0",
    "lru-cache": "^11.0.0",
    "sql.js": "^1.10.3",
    "zod": "^4.3.6"
  },
  "overrides": {
    "minimatch": ">=10.2.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.9",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0"
  }
}